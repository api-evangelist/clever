{
  "opencollection": "1.0.0",
  "info": {
    "name": "Data Assignments Terms API",
    "version": "3.1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://clever.com/oauth/authorize",
      "accessTokenUrl": "https://clever.com/oauth/tokens",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Terms",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "getTerms",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.clever.com/v3.1/terms",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "starting_after",
                "value": "",
                "type": "query"
              },
              {
                "name": "ending_before",
                "value": "",
                "type": "query"
              },
              {
                "name": "count",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns a list of terms"
        },
        {
          "info": {
            "name": "getTerm",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.clever.com/v3.1/terms/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns a specific term"
        },
        {
          "info": {
            "name": "getDistrictForTerm",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.clever.com/v3.1/terms/:id/district",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns the district for a term"
        },
        {
          "info": {
            "name": "getSchoolsForTerm",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.clever.com/v3.1/terms/:id/schools",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "starting_after",
                "value": "",
                "type": "query"
              },
              {
                "name": "ending_before",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns the schools for a term"
        },
        {
          "info": {
            "name": "getSectionsForTerm",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.clever.com/v3.1/terms/:id/sections",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "starting_after",
                "value": "",
                "type": "query"
              },
              {
                "name": "ending_before",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns the sections for a term"
        }
      ]
    }
  ],
  "bundled": true
}